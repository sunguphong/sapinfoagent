# Anthropic Claude API (https://console.anthropic.com에서 발급)
ANTHROPIC_API_KEY=sk-ant-...
# Gmail SMTP (앱 비밀번호 필요: Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호)
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# 수신자 (여러 명은 쉼표로 구분)
MAIL_TO=your@gmail.com
# 선택: 수집 기간(시간), 최대 기사 수
LOOKBACK_HOURS=24
MAX_ARTICLES=40
# 관리 웹 접속 계정 (외부 공개 시 필수, 8자 이상)
WEB_USER=admin
WEB_PASS=change-me-8chars
# 외부 공개 주소 이름 (https://<이름>.loca.lt)
LT_SUBDOMAIN=sap-info-agent
